# Database.
# In SVILUPPO LOCALE: PostgreSQL "embedded" avviato da `npm run dev` (questo URL):
DATABASE_URL="postgresql://dev:dev@localhost:5433/commanderone_dev"
# In PRODUZIONE: lo fornisce Railway come variabile DATABASE_URL (non da questo file).

# Segreto per firmare i JWT — stringa casuale di almeno 32 caratteri.
# Genera con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="change-me-with-a-long-random-string"

# Porta del server (Railway la imposta da solo; in locale 3001)
PORT=3001

# Origine consentita per CORS — URL del frontend (su Vercel in produzione)
FRONTEND_URL="http://localhost:5173"

# Chiave Groq per il Judge Bot (opzionale: senza, o se Groq non risponde, si passa
# in automatico al fallback gratuito senza LLM — solo ricerca testuale nelle regole
# ufficiali, vedi JUDGE_DAILY_LLM_CAP sotto)
GROQ_API_KEY=""

# Tetto giornaliero (globale, UTC, tutti i gruppi insieme) di domande al judge che
# possono usare Groq. Superato il tetto, /judge continua a rispondere ma passa al
# fallback gratuito (oracle text + ruling Scryfall + ricerca locale nelle CR, zero
# chiamate LLM) invece di fallire o generare costi imprevisti. Margine conservativo
# sotto il piano free di Groq (~500 domande/giorno = 2 chiamate ciascuna).
JUDGE_DAILY_LLM_CAP=300

# Email transazionali (verifica indirizzo, reset password) via https://resend.com
# In locale puoi lasciarla vuota: le email vengono stampate in console.
RESEND_API_KEY=""
# Mittente delle email (dominio verificato su Resend in produzione)
MAIL_FROM="CommanderOne <onboarding@resend.dev>"
